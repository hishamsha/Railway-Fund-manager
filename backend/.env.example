NODE_ENV=development
PORT=3000
# Restricted server-side Supabase PostgreSQL URL. Never put this in mobile.
DATABASE_URL=postgresql://app_runtime:REPLACE_ME@DB_HOST:5432/postgres?schema=app
# M02: RSA PEM files must be present only on the API host. Use distinct keys per environment.
JWT_PRIVATE_KEY_FILE=ABSOLUTE_PATH_TO_PRIVATE_PEM
JWT_PUBLIC_KEY_FILE=ABSOLUTE_PATH_TO_PUBLIC_PEM
# Optional key rotation map. When set, include the active kid and any unexpired retired key.
# JWT_PUBLIC_KEYS_JSON={"development-1":"-----BEGIN PUBLIC KEY-----\\n..."}
JWT_ACTIVE_KID=development-1
# Hosting only: proxies in front of the API, and the built web app folder.
# TRUST_PROXY_HOPS=1
# WEB_DIST=/app/web
JWT_ISSUER=train-fund-manager-api
JWT_AUDIENCE=train-fund-manager-mobile
